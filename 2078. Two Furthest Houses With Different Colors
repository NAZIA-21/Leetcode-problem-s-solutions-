class Solution {
    public int maxDistance(int[] colors) {

        int distanceL = 0;
        int distanceR = 0;
        int p1 = 0;
        int pn = colors.length - 1;

        for(int p2 = 1; p2 < colors.length; p2++){

            if(colors[p1] != colors[p2]){
                distanceL = Math.max(distanceL, Math.abs(p1 - p2));
            }

        }

        for(int p2 = pn - 1; p2 >= 0; p2--){

            if(colors[pn] != colors[p2]){
                distanceR = Math.max(distanceR, Math.abs(pn - p2));
            }

        }
        return Math.max(distanceL, distanceR);
    }
}
