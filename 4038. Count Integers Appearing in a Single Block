//TC: O(n)
//SC: O(n)

class Solution {
    public int countSpecialIntegers(int[] nums) {

        HashSet ans = new HashSet<>();
        HashSet seen = new HashSet<>();

        for(int i = 0; i < nums.length; i++){
            if(i == 0 || nums[i] != nums[i-1]){
                if(seen.contains(nums[i])){
                    ans.remove(nums[i]);
                } else{
                    seen.add(nums[i]);
                    ans.add(nums[i]);
                }
            }
        }
        return ans.size();
    }
}
