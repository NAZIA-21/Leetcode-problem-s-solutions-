//TC: O(n)
//SC: O(n)

class Solution {
    public int[] resultArray(int[] nums) {

        int n = nums.length;

        int[] arr1 = new int[n];
        int[] arr2 = new int[n];

        arr1[0] = nums[0];
        arr2[0] = nums[1];

        int firstIdx = 0;
        int secInx = 0;
        
        for(int i = 2; i < n; i++){

            if(arr1[firstIdx] > arr2[secInx]){

                arr1[firstIdx+1] = nums[i];
                firstIdx++;

            } else{

                arr2[secInx+1] = nums[i];
                secInx++;

            }
        }

        int idx = 0;
        
        while(idx < secInx+1){

            arr1[firstIdx+1] = arr2[idx];
            firstIdx++;
            idx++; 
            
        }

        return arr1;
        
    }
}
