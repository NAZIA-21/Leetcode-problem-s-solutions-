class Solution {
    public int firstStableIndex(int[] nums, int k) {

        int n = nums.length;
        
        int minValArr[] = new int[n];
        minValArr[n - 1] = nums[n - 1];

        for (int i = n - 2; i >= 0; i--) {

            minValArr[i] = Math.min(nums[i], minValArr[i+1]);

        }

        int max = nums[0];

        for (int i = 0; i < n; i++) {

            max = Math.max(max, nums[i]);
            int instability = max - minValArr[i];

            if (instability <= k) {

                return i;
                
            }

        }

        return -1;

    }
}
